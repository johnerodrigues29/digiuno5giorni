# ===================================================================
# CONFIGURAÇÕES DE CACHE OTIMIZADAS
# ===================================================================

RewriteEngine On

# ===================================================================
# FORÇAR HTTPS E REMOVER WWW
# ===================================================================
RewriteCond %{HTTP_HOST} ^(?:www\.)?digiuno5giorni\.it$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.digiuno5giorni\.it$ [NC]
RewriteRule ^(.*)$ https://digiuno5giorni.it/$1 [R=301,L]

# ===================================================================
# REMOVER .html DA URL E TRATAR REQUESTS
# ===================================================================

# Redirecionar /pagina.html para /pagina
RewriteCond %{THE_REQUEST} /([^\s/]+)\.html [NC]
RewriteRule ^([^\s/]+)\.html$ /$1 [R=301,L]

# Servir pagina.html quando acessar /pagina
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-zA-Z0-9\-]+)/?$ $1.html [L]

# Redirecionar /index.html para /
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

# ===================================================================
# CONFIGURAÇÕES DE CACHE
# ===================================================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Imagens
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS e JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    # Fontes
    ExpiresByType application/font-woff "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 month"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 month"
    ExpiresByType application/x-font-ttf "access plus 1 month"
    ExpiresByType font/opentype "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <filesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "max-age=31536000, public"
    </filesMatch>
    <filesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </filesMatch>
    <filesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "max-age=2592000, public"
    </filesMatch>
</IfModule>
